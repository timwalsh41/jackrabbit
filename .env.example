# Jackrabbit Configuration
# Copy this file to .env and adjust values as needed

# Server port
PORT=8080

# Data directory for SQLite database and other persistent data
DATA_DIR=./data

# Database URL (SQLite by default)
DATABASE_URL=sqlite:///./data/jackrabbit.db

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Environment (development, staging, production)
ENVIRONMENT=development

# Echo every SQL statement to the log. Verbose: the backlog view issues one
# query per ticket. Independent of ENVIRONMENT.
DEBUG_SQL=false