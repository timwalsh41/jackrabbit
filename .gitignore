# Agent config (local)
# NOTE: docs/agents/ is deliberately NOT ignored. The tracked AGENTS.md points
# at those files, and the subagent roles read them from their own worktrees,
# where a gitignored file does not exist.
.agents/
.pi/
skills-lock.json

# Bytecode
__pycache__/
*.py[cod]
*$py.class

# Build artifacts
frontend/node_modules/
*.egg-info/
dist/
build/
*.egg

# Local data / env
.env
data/
*.db
*.sqlite*

# Test artifacts
.coverage
htmlcov/
.pytest_cache/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Lock files (optional - team choice)
# uv.lock
